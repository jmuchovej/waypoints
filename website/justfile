set script-interpreter := ["bash", "-euo", "pipefail"]
# Loading `.dev.vars` for tools with no dotenv flag. Also optional on purpose.
set dotenv-filename := ".dev.vars"
set dotenv-required := false

worker := "website"

[private]
default:
    @just --list

[private]
via-nuxi +ARGS:
    pnpm exec nuxi {{ ARGS }}

# Run the dev server, with Cloudflare bindings emulated by wrangler.
dev: gen-dev-vars
    @just via-nuxi dev --dotenv .dev.vars

setup: postinstall

generate:
    @just via-nuxi generate

postinstall:
    @just via-nuxi prepare

typecheck:
    @just via-nuxi typecheck

clean:
    @just via-nuxi cleanup

test *ARGS:
    pnpm exec vitest {{ ARGS }}

add +ARGS:
    pnpm add {{ ARGS }}

# Build vs runtime, because the split is not obvious:
#
#   BUILD TIME  — anything inlined into the client bundle or needed while
#                 prerendering. That is every NUXT_PUBLIC_* value, plus
#                 NUXT_GITHUB_TOKEN (the /api/v1/update/*.json routes are
#                 prerendered and call the GitHub API). These must be in the
#                 environment when `nuxi build` runs. Locally that happens via
#                 the parse-time load of .dev.vars above (run `gen-dev-vars`
#                 first); in CI, `eval "$(just website::secrets-export)"`.
#
#   RUNTIME     — everything the Worker reads per request. Uploaded to
#                 Cloudflare with `secrets-push` and read through
#                 `useRuntimeConfig(event)`.

# Build the SSR Worker bundle into .output/ (server + public assets).
build:
    @just via-nuxi build

# Deploy the built Worker using the config Nitro generates from wrangler.toml.
deploy: build
    wrangler deploy --config .output/server/wrangler.json

# Serve the built Worker in workerd itself, the closest local mirror of prod.
preview: build
    wrangler dev --config .output/server/wrangler.json

# Reads NUXT_TURSO_* from the parse-time .dev.vars load above, so it must be run
# through just rather than `pnpm exec drizzle-kit` directly.
#
# Run drizzle-kit, e.g. `just website::db push` or `just website::db studio`.
db +ARGS:
    pnpm exec drizzle-kit {{ ARGS }}

# The `website` secretspec profile is where these recipes read from. It
# defaults to the wp-web 1Password vault (the desktop app authorises a local
# run); `SECRETSPEC_PROVIDER=sops-web` reads a local, gitignored
# `secrets.sops.yaml` instead.

# Render .dev.vars from the website profile.
[script]
gen-dev-vars:
    umask 077
    tmp="$(mktemp .dev.vars.XXXXXX)"
    trap 'rm -f "$tmp"' EXIT
    secretspec export --profile website --format dotenv \
      --reason "just website::gen-dev-vars renders .dev.vars for the local dev server" \
      > "$tmp"
    mv "$tmp" .dev.vars
    echo "wrote .dev.vars ($(grep -c . .dev.vars) vars) from the website profile"

# Push every secret in the website profile to the Worker in one call.
[script]
secrets-push:
    secretspec export --profile website --format json \
      --reason "just website::secrets-push uploads the website profile to the Worker" \
      | wrangler secret bulk --name {{ worker }}

# Show which secret names are currently set on the Worker.
secrets-list:
    wrangler secret list --name {{ worker }}

# Export the website profile into the current shell, for a build that needs
# the values at BUILD time (CI). Usage: `eval "$(just website::secrets-export)"`
[private]
secrets-export:
    @secretspec export --profile website --format shell \
      --reason "just website::secrets-export exposes the website profile to a build"
