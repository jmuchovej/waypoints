[private]
default:
    @just --list

[private]
via-nuxi +ARGS:
    bunx nuxi {{ ARGS }}

# Resolve a flavor's bundle identifier from its Tauri config (single source of truth).
[private]
_identifier flavor:
    @yq -p toml -o yaml '.identifier' "{{ justfile_directory() }}/src-tauri/Tauri.flavor={{ flavor }}.toml"

dev flavor="development":
    VITE_WAYPOINTS_FLAVOR=$(just _identifier {{ flavor }}) just via-nuxi dev

setup: postinstall

generate flavor="development":
    VITE_WAYPOINTS_FLAVOR=$(just _identifier {{ flavor }}) just via-nuxi generate

postinstall:
    @just via-nuxi prepare

typecheck:
    @just via-nuxi typecheck

clean:
    @just via-nuxi cleanup

[private]
via-storybook +ARGS:
    bunx storybook {{ ARGS }}

storybook-dev:
    @just via-storybook dev --port 9298

storybook-build:
    @just via-storybook build

test *ARGS:
    bunx vitest {{ ARGS }}

add +ARGS:
    bun add {{ ARGS }}
