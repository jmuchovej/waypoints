mod icons "./icons/justfile"

[private]
default:
    @just --list

[private]
via-tauri +ARGS="--debug":
    cargo tauri {{ ARGS }}

# Requires rustup, bun, cargo-tauri, just, and sops in your [nix] profile.
[private]
via-tauri-build +ARGS:
    #!/usr/bin/env bash
    set -euo pipefail
    sops_file="${PROJECT_ROOT}/.secrets/signing-apple.sops.yaml"
    key_path=$(mktemp "${TMPDIR:-/tmp}/AuthKey.XXXXXX.p8")
    trap 'rm -f "${key_path}"' EXIT
    secrets=$(sops -d "${sops_file}")
    echo "${secrets}" | yq '.private-key' > "${key_path}"
    env -i \
        HOME="$HOME" \
        USER="$USER" \
        PATH="/usr/bin:/bin:/usr/sbin:/sbin:$HOME/.nix-profile/bin:$HOME/.cargo/bin:$HOME/.bun/bin" \
        APPLE_API_ISSUER="$(echo "${secrets}" | yq '.issuer-id')" \
        APPLE_API_KEY="$(echo "${secrets}" | yq '.key-id')" \
        APPLE_API_KEY_PATH="${key_path}" \
        APPLE_CERTIFICATE="$(echo "${secrets}" | yq '.certificate')" \
        APPLE_CERTIFICATE_PASSWORD="$(echo "${secrets}" | yq '.password')" \
        cargo tauri build {{ ARGS }}

clean:
    cargo clean

# Development — mock seed data, debug build
dev $RUST_LOG="debug" $RUST_BACKTRACE="1" *ARGS:
    @just icons::dev
    @just via-tauri dev --features development --config Tauri.flavor=development.toml {{ ARGS }}

# Preview — signed release-optimized build
preview *ARGS:
    @just icons::preview
    @just via-tauri-build --features preview --config Tauri.flavor=preview.toml {{ ARGS }}

# Stable — signed, production build
stable *ARGS:
    @just icons::stable
    @just via-tauri-build --features stable {{ ARGS }}

ios +ARGS:
    @just via-tauri ios {{ ARGS }}

android +ARGS:
    @just via-tauri android {{ ARGS }}
