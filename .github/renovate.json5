{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "group:allNonMajor",
    ":maintainLockFilesWeekly",
    ":semanticCommitTypeAll(chore)",
  ],
  minimumReleaseAge: "5 days",
  rangeStrategy: "bump",
  lockFileMaintenance: {
    enabled: true,
  },
  schedule: ["on Monday"],
  mise: {
    enabled: false,
  },
  ignorePaths: [
    "**/node_modules/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "src-tauri/gen/**",
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Actions pinned in xtask, which generates .github/workflows from them. The digest is the commit the release in the trailing comment pointed at when pinned; Renovate moves comment and digest together.",
      managerFilePatterns: ["tooling/xtask/src/tasks/workflows/_steps.rs"],
      matchStrings: [
        'Action::new\\(\\s*"(?<owner>[^"]+)",\\s*"(?<repo>[^"]+)",\\s*"(?<currentDigest>[0-9a-f]{40})", // (?<currentValue>\\S+)',
      ],
      depNameTemplate: "{{{owner}}}/{{{repo}}}",
      datasourceTemplate: "github-tags",
    },
  ],
  packageRules: [
    {
      description: "Every workflow is generated by `cargo xtask workflows`. Bump the action in tooling/xtask/src/tasks/workflows/_steps.rs instead, which the custom manager above tracks.",
      matchManagers: ["github-actions"],
      matchFileNames: [".github/workflows/**"],
      enabled: false,
    },
    {
      description: "Pinned to =2.0.0-rc.25 to match the local forks in vendor/specta-macros and vendor/specta-serde wired in via [patch.crates-io]. A bump silently invalidates both patches, so re-derive them by hand.",
      matchManagers: ["cargo"],
      matchPackageNames: [
        "specta",
        "specta-macros",
        "specta-serde",
        "specta-typescript",
        "tauri-specta",
      ],
      enabled: false,
    },
    {
      description: "waypoints-hq fork, rev-pinned deliberately; bump by hand when the fork moves.",
      matchManagers: ["cargo"],
      matchPackageNames: ["gh-workflow"],
      enabled: false,
    },
    {
      matchDepTypes: ["resolutions"],
      enabled: false,
    },
    {
      matchUpdateTypes: ["minor", "patch"],
      matchManagers: ["cargo", "rust-toolchain"],
      groupName: "cargo non-major",
      groupSlug: "cargo-minor-patch",
    },
    {
      description: "Default catalog (repo-wide workflow tooling) plus any non-catalog manifest deps. The website/app catalogs override this below.",
      matchUpdateTypes: ["minor", "patch"],
      matchManagers: ["npm"],
      groupName: "npm non-major",
      groupSlug: "npm-minor-patch",
    },
    {
      matchUpdateTypes: ["minor", "patch"],
      matchDepTypes: ["pnpm.catalog.website"],
      groupName: "website non-major",
      groupSlug: "website-minor-patch",
    },
    {
      description: "Covers src/, crates/domain and tooling/icongen, which all draw from the app catalog.",
      matchUpdateTypes: ["minor", "patch"],
      matchDepTypes: ["pnpm.catalog.app"],
      groupName: "app non-major",
      groupSlug: "app-minor-patch",
    },
    {
      description: "Tiptap ships all packages from one release; mixing minors breaks the shared ProseMirror schema.",
      matchDepTypes: ["pnpm.catalog.tiptap"],
      groupName: "tiptap",
    },
    {
      description: "Storybook addons load through the core runtime; a major mismatch fails at boot.",
      matchDepTypes: ["pnpm.catalog.storybook"],
      groupName: "storybook",
    },
    {
      description: "Tauri JS and Rust must move together — a version skew surfaces as a runtime IPC failure, not a build error. Spans two managers, so it must outrank both the npm and cargo non-major groups.",
      matchPackageNames: ["@tauri-apps/**", "tauri", "tauri-build", "tauri-plugin-**", "wry"],
      groupName: "tauri",
    },
    {
      description: "iroh 1.0.x pins ed25519-dalek exactly; upgrade the curve25519 family as one unit.",
      matchManagers: ["cargo"],
      matchPackageNames: ["iroh", "ed25519-dalek", "x-wing", "rand", "rand_core"],
      groupName: "iroh + curve25519",
    },
    {
      description: "bedrock's durability posture and generated SQL are tested against this exact engine build; keep it out of the cargo group and gate it on the dashboard. `turso` is only the facade and `turso_core` is the engine it clamps — they are exact-pinned in the workspace manifest and must bump in lockstep, and accepting a bump requires re-running bedrock's durability suites (see the pin comment in Cargo.toml).",
      matchManagers: ["cargo"],
      matchPackageNames: ["turso", "turso_core"],
      groupName: "turso",
      dependencyDashboardApproval: true,
    },
    {
      matchUpdateTypes: ["major"],
      matchDepTypes: ["pnpm.catalog.website"],
      matchPackageNames: ["nuxt", "@nuxt/kit"],
      groupName: "nuxt framework (website)",
    },
    {
      matchUpdateTypes: ["major"],
      matchDepTypes: ["pnpm.catalog.app"],
      matchPackageNames: ["nuxt", "@nuxt/kit"],
      groupName: "nuxt framework (app)",
    },
  ],
  postUpdateOptions: ["pnpmDedupe"],
}
