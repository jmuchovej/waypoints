# Distribution: one module per distribution channel that has recipes.

[private]
default:
    @just --list --list-submodules

[doc("Fails if any package manifest under distribution/ is stamped with a release's tag, digest, or versioned URL.")]
check:
    cd .. && cargo xtask dist check

# Station deployment: manifest validation and a kind cluster
mod kubernetes "kubernetes/justfile"

# The Nix channel: refreshing the hashes the app recipe pins
mod nix "nix/justfile"

# Homebrew: style and audit the rendered casks
mod brew "brew/justfile"

# The AUR: check the rendered PKGBUILDs on an Arch host
mod aur "aur/justfile"
