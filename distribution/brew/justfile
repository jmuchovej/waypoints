# Homebrew: style-check and audit the rendered casks under target/dist/brew/.
# Render first (`cargo xtask dist render brew --flavor <flavor>`).

set script-interpreter := ["bash", "-euo", "pipefail"]

# `brew audit` reads casks by name from a tap, never by path.
tap := "waypoints/dist-check"

[private]
default:
    @just --list

[doc("Runs `brew style` and `brew audit` on every rendered cask, for this host and for x86_64 Linux. Reports skipped where brew is not installed.")]
[script]
audit:
    if ! command -v brew >/dev/null; then
      echo "skipped: brew is not installed"
      exit 0
    fi
    shopt -s nullglob
    casks=(../../target/dist/brew/*/*.rb)
    if [ "${#casks[@]}" -eq 0 ]; then
      echo "no rendered casks under target/dist/brew/; render them first" >&2
      exit 1
    fi

    # A developer command for this run only, without flipping the setting.
    export HOMEBREW_DEVELOPER=1 HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1
    brew --version | head -1
    brew style --cask "${casks[@]}"

    brew tap-new --no-git "{{ tap }}" >/dev/null
    trap 'brew untap "{{ tap }}" >/dev/null' EXIT
    dir="$(brew --repository "{{ tap }}")/Casks"
    mkdir -p "$dir"
    cp "${casks[@]}" "$dir/"
    for cask in "${casks[@]}"; do
      token="$(basename "$cask" .rb)"
      brew audit --cask "{{ tap }}/$token"
      brew audit --cask --os linux --arch x86_64 "{{ tap }}/$token"
    done
