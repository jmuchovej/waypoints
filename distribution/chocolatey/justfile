# Chocolatey: pack the rendered packages under target/dist/chocolatey/.
# Render first (`cargo xtask dist render chocolatey --flavor <flavor>`).

set script-interpreter := ["bash", "-euo", "pipefail"]

[private]
default:
    @just --list

[doc("Runs `choco pack` on each rendered nuspec. Reports skipped where choco is not installed.")]
[script]
check:
    if ! command -v choco >/dev/null; then
      echo "skipped: choco is not installed (a Windows host packs the packages)"
      exit 0
    fi
    shopt -s nullglob
    specs=(../../target/dist/chocolatey/*/*.nuspec)
    if [ "${#specs[@]}" -eq 0 ]; then
      echo "no rendered nuspecs under target/dist/chocolatey/; render them first" >&2
      exit 1
    fi
    for spec in "${specs[@]}"; do
      choco pack "$spec" --output-directory "$(dirname "$spec")"
    done
