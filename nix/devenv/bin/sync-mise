#!/usr/bin/env nu

# Regenerate mise.lock, then verify that every tool declared in
# .config/mise.toml actually resolved — mise silently skips tools whose
# backend spec is wrong, so a count mismatch means a broken spec.

let root = $env.PROJECT_ROOT? | default (pwd)
let mise_toml = $root | path join ".config" "mise.toml"

# mise reads `GITHUB_TOKEN`/`MISE_GITHUB_TOKEN`, not `GH_TOKEN` — the name
# secretspec declares and the one the gh CLI uses. Without a token it falls back
# to sixty anonymous API requests an hour, which this tool set exhausts before
# it finishes: the lockfile then comes out short, and mise reports success
# anyway. Map whichever name is present.
let token = ($env.GITHUB_TOKEN? | default ($env.GH_TOKEN? | default ""))

if ($token | is-empty) {
  print -e "warning: no GITHUB_TOKEN or GH_TOKEN in the environment."
  print -e "mise will make anonymous GitHub requests, capped at sixty an hour,"
  print -e "and may write a lockfile missing entries without reporting an error."
  mise lock
} else {
  with-env {GITHUB_TOKEN: $token} { mise lock }
}

# mise lists `core:` backend tools under their bare names (core:node -> node).
# A tool restricted to other OSes (`os = [...]`) is skipped here on purpose.
let this_os = $nu.os-info.name
let declared = (
  open $mise_toml
  | get tools
  | transpose tool spec
  | where {|row|
      let spec = $row.spec
      if ($spec | describe | str starts-with "record") {
        $this_os in ($spec.os? | default [$this_os])
      } else {
        true
      }
    }
  | get tool
  | each {|tool| $tool | str replace -r '^core:' ''}
)
let resolved = (
  mise ls --current --json
  | from json
  | transpose tool installs
  | where {|row| ($row.installs.0?.source?.path? | default "") == $mise_toml}
  | get tool
)

let missing = $declared | where {|tool| $tool not-in $resolved}

if ($missing | is-empty) {
  print $"mise.lock regenerated; all ($declared | length) declared tools resolved"
} else {
  print -e $"mise resolved only ($resolved | length) of the ($declared | length) tools in .config/mise.toml."
  print -e $"Missing: ($missing | sort | str join ', ')"
  print -e "Add the missing tool to the mise-formatters `unavailable` list in"
  print -e "devenv.nix, or give it a correct backend spec."
  exit 1
}
