mod app "../src/justfile"
mod icons "../waypoints/icons/justfile"

[private]
default:
    @just --list

[private]
via-tauri +ARGS="--debug":
    cargo tauri {{ ARGS }}

# Requires rustup, bun, cargo-tauri, just, and op in your [nix] profile.
[private]
via-tauri-build +ARGS:
    #!/usr/bin/env bash
    set -euo pipefail
    key_path="{{ justfile_directory() }}/../.secrets/AuthKey.p8"
    mkdir -p "$(dirname "${key_path}")"
    op read "op://waypoints.so/Apple Signing/private-key" > "$key_path"
    env -i \
        HOME="$HOME" \
        USER="$USER" \
        PATH="/usr/bin:/bin:/usr/sbin:/sbin:$HOME/.nix-profile/bin:$HOME/.cargo/bin:$HOME/.bun/bin" \
        APPLE_API_ISSUER="op://waypoints.so/Apple Signing/issuer-id" \
        APPLE_API_KEY="op://waypoints.so/Apple Signing/key-id" \
        APPLE_API_KEY_PATH="$key_path" \
        APPLE_CERTIFICATE="op://waypoints.so/Apple Signing/certificate" \
        APPLE_CERTIFICATE_PASSWORD="op://waypoints.so/Apple Signing/password" \
        op run -- cargo tauri build {{ ARGS }}

clean:
    cargo clean

# Development — mock seed data, debug build
dev $RUST_LOG="debug" $RUST_BACKTRACE="1" *ARGS:
# Generate .icns and .ico from each flavor's iconset
icons:
    #!/usr/bin/env bash
    set -euo pipefail
    for json in icons/*.json; do
        flavor="$(basename "$json" .json)"
        iconset="icons/$(yq -p json -oy '.iconset' "$json")"

        echo "[$flavor] $iconset → icons/icon-${flavor}.icns, icons/icon-${flavor}.ico"

        # macOS .icns
        iconutil -c icns "$iconset" -o "icons/icon-${flavor}.icns"

        # Windows .ico (multi-resolution)
        magick "$iconset/icon_256x256.png" \
               "$iconset/icon_128x128.png" \
               "$iconset/icon_32x32.png" \
               "$iconset/icon_16x16.png" \
               "icons/icon-${flavor}.ico"
    done
    @just via-tauri dev --features development --config Tauri.flavor=development.toml {{ ARGS }}

# Preview — signed release-optimized build
preview *ARGS:
    @just via-tauri-build --features preview --config Tauri.flavor=preview.toml {{ ARGS }}

# Stable — signed, production build
stable *ARGS:
    @just via-tauri-build --features stable {{ ARGS }}

ios +ARGS:
    @just via-tauri ios {{ ARGS }}

android +ARGS:
    @just via-tauri android {{ ARGS }}
