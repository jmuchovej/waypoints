# Dev servers and builds for every platform go through `xtauri` (on PATH from
# tooling/bin, under devenv and mise alike), which owns the environment, the
# secrets, the flavor spellings, and what `desktop` means on this host. These
# recipes exist so `just` stays the one entry point and so a dev server gets
# its logging defaults.

[private]
default:
    @just --list

# Run a dev server: `just tauri::dev [desktop|macos|linux|windows|ios|android] [flavor]`.
dev target="desktop" flavor="development" $RUST_LOG="debug" $RUST_BACKTRACE="1" *ARGS:
    xtauri dev {{ target }} --flavor {{ flavor }} {{ ARGS }}

# Build and sign: `just tauri::build [target] [flavor]`; CI calls this per platform.
build target="desktop" flavor="stable" *ARGS:
    xtauri build {{ target }} --flavor {{ flavor }} {{ ARGS }}

clean:
    cargo clean

setup:
