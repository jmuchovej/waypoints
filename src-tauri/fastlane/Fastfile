opt_out_usage

# The aab or ipa `xfastlane publish` found in the staged directory. Only ever
# a staged package: `release-stage` has already required exactly one.
def staged_package
  ENV.fetch("WAYPOINTS_STORE_PACKAGE") do
    UI.user_error!("No staged package — run the lane through `xfastlane publish`")
  end
end

# TestFlight's "What to Test", written per release by
# `xfastlane metadata`. Absent when the tag carried no
# changelog-worthy commits, in which case the field is left as it was —
# better than the same stale blurb on every build.
#
# Anchored on the Fastfile rather than the working directory: supply and
# deliver resolve their own paths from here too.
def release_notes(locale = "en-US")
  path = File.expand_path("metadata/#{locale}/release_notes.txt", __dir__)
  return nil unless File.exist?(path)

  notes = File.read(path).strip
  notes.empty? ? nil : notes
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APPLE_API_KEY"),
    issuer_id: ENV.fetch("APPLE_API_ISSUER"),
    key_filepath: ENV.fetch("APPLE_API_KEY_PATH"),
    in_house: false,
  )
end

platform :android do
  desc "Upload nightly AAB to Play Store internal track"
  lane :nightly do
    upload_to_play_store(
      track: "internal",
      aab: staged_package,
      skip_upload_apk: true,
    )
  end

  desc "Upload preview AAB to Play Store internal track"
  lane :preview do
    upload_to_play_store(
      track: "internal",
      aab: staged_package,
      skip_upload_apk: true,
    )
  end

  desc "Upload stable AAB to Play Store production track"
  lane :stable do
    upload_to_play_store(
      track: "production",
      aab: staged_package,
      skip_upload_apk: true,
    )
  end
end

platform :ios do
  desc "Upload nightly build to TestFlight internal testing"
  lane :nightly do
    asc_api_key
    upload_to_testflight(
      ipa: staged_package,
      changelog: release_notes,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
    )
  end

  desc "Upload preview build to TestFlight"
  lane :preview do
    asc_api_key
    upload_to_testflight(
      ipa: staged_package,
      changelog: release_notes,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: true,
    )
  end

  desc "Upload stable build to TestFlight"
  lane :stable do
    asc_api_key
    upload_to_app_store(
      ipa: staged_package,
      changelog: release_notes,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: true,
      metadata_path: "./metadata/ios",
      screenshots_path: "./metadata/ios/screenshots",
    )
  end
end
