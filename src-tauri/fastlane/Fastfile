opt_out_usage

# `xfastlane publish --from` names the staged package; otherwise the lanes
# take the build output.
def staged_package
  ENV.fetch("WAYPOINTS_STORE_PACKAGE", nil)
end

def android_aab
  return staged_package if staged_package

  project = ENV.fetch("TAURI_ANDROID_PROJECT_PATH")
  pattern = File.join(project, "app/build/outputs/bundle/*Release/*.aab")
  matches = Dir.glob(pattern)

  case matches.length
  when 1 then matches.first
  when 0 then UI.user_error!("No AAB found at #{pattern} — was `just tauri::build android` run?")
  else UI.user_error!("Ambiguous AAB: #{matches.join(", ")}")
  end
end

# `upload_to_testflight` only finds an ipa on its own when `gym` ran in the
# same lane; ours comes from `cargo tauri ios build`, so it is located here.
def ios_ipa
  return staged_package if staged_package

  project = ENV.fetch("TAURI_IOS_PROJECT_PATH")
  pattern = File.join(project, "build/**/*.ipa")
  matches = Dir.glob(pattern)

  case matches.length
  when 1 then matches.first
  when 0 then UI.user_error!("No ipa found at #{pattern} — was `just tauri::build ios` run?")
  else UI.user_error!("Ambiguous ipa: #{matches.join(", ")}")
  end
end

def flavor_identifier(flavor)
  case flavor
  when "preview" then "so.waypoints.preview"
  when "nightly" then "so.waypoints.nightly"
  else "so.waypoints"
  end
end

# TestFlight's "What to Test", written per release by
# `xfastlane metadata`. Absent when the tag carried no
# changelog-worthy commits, in which case the field is left as it was —
# better than the same stale blurb on every build.
#
# Anchored on the Fastfile rather than the working directory: supply and
# deliver resolve their own paths from here too.
def release_notes(locale = "en-US")
  path = File.expand_path("metadata/#{locale}/release_notes.txt", __dir__)
  return nil unless File.exist?(path)

  notes = File.read(path).strip
  notes.empty? ? nil : notes
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APPLE_API_KEY"),
    issuer_id: ENV.fetch("APPLE_API_ISSUER"),
    key_filepath: ENV.fetch("APPLE_API_KEY_PATH"),
    in_house: false,
  )
end

platform :android do
  desc "Upload nightly AAB to Play Store internal track"
  lane :nightly do
    upload_to_play_store(
      package_name: flavor_identifier("nightly"),
      track: "internal",
      aab: android_aab,
      skip_upload_apk: true,
    )
  end

  desc "Upload preview AAB to Play Store internal track"
  lane :preview do
    upload_to_play_store(
      package_name: flavor_identifier("preview"),
      track: "internal",
      aab: android_aab,
      skip_upload_apk: true,
    )
  end

  desc "Upload stable AAB to Play Store production track"
  lane :stable do
    upload_to_play_store(
      package_name: flavor_identifier("stable"),
      track: "production",
      aab: android_aab,
      skip_upload_apk: true,
    )
  end
end

platform :ios do
  desc "Upload nightly build to TestFlight internal testing"
  lane :nightly do
    asc_api_key
    upload_to_testflight(
      ipa: ios_ipa,
      changelog: release_notes,
      app_identifier: flavor_identifier("nightly"),
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
    )
  end

  desc "Upload preview build to TestFlight"
  lane :preview do
    asc_api_key
    upload_to_testflight(
      ipa: ios_ipa,
      changelog: release_notes,
      app_identifier: flavor_identifier("preview"),
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: true,
    )
  end

  desc "Upload stable build to TestFlight"
  lane :stable do
    asc_api_key
    upload_to_app_store(
      ipa: ios_ipa,
      changelog: release_notes,
      app_identifier: flavor_identifier("stable"),
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: true,
      metadata_path: "./metadata/ios",
      screenshots_path: "./metadata/ios/screenshots",
    )
  end
end
