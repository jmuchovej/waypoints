{
  "load_direnv": "direct",
  "format_on_save": "on",
  "formatter": {
    "external": {
      "command": "treefmt",
      "arguments": ["--no-cache", "--stdin", "{buffer_path}"]
    }
  },
  "lsp": {
    "vue-language-server": {
      "settings": {
        // Display inlay hints for the `$event` parameter in inline event handlers.
        "vue.inlayHints.inlineHandlerLeading": true,
        // Display hints when required component props are missing in templates.
        "vue.inlayHints.missingProps": true,
        // Display inlay hints for patterns that wrap component options.
        "vue.inlayHints.optionsWrapper": true,
        // Display inlay hints related to `v-bind` shorthand (`:`).
        "vue.inlayHints.vBindShorthand": true
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "vue": "html"
        },
        "experimental": {
          "classRegex": [
            "class=\"([^\"]*)\"",
            "class='([^']*)'",
            ":class=\"([^\"]*)\"",
            ":class='([^']*)'",
            "\\.className\\s*[+]?=\\s*['\"]([^'\"]*)['\"]",
            "\\.setAttributeNS\\(.*,\\s*['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
            "\\.setAttribute\\(['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
            "\\.classList\\.add\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.remove\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.toggle\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.contains\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.replace\\(\\s*['\"]([^'\"]*)['\"]",
            "\\.classList\\.replace\\([^,)]+,\\s*['\"]([^'\"]*)['\"]"
          ]
        }
      }
    },
    "ruby-lsp": {
      "settings": {
        "use_bundler": false
      },
      "initialization_options": {
        "linters": ["rubocop"]
      }
    },
    "tinymist": {
      "settings": {
        "exportPdf": "never",
        "exportTarget": "bundle",
        "lint": {
          "enabled": true,
          "when": "onSave"
        }
      }
    }
  },
  "languages": {
    "TypeScript": {
      "language_servers": ["typescript-language-server", "!vtsls", "!biome"]
    },
    "TSX": {
      "language_servers": ["typescript-language-server", "!vtsls", "!biome"]
    },
    "JavaScript": {
      "language_servers": ["typescript-language-server", "!vtsls", "!biome"]
    },
    "CSS": {
      "language_servers": ["tailwindcss-intellisense-css", "!vscode-css-language-server", "!biome"]
    },
    "Ruby": {
      "language_servers": ["ruby-lsp", "!solargraph"]
    }
  },
  "file_types": {
    "Ruby": ["Fastfile", "Appfile", "Podfile"],
    "XML": ["*.plist", "*.storyboard", "*.entitlements"],
    "TOML": ["mise*.lock", ".config/mise/**/*.lock"]
  },
  "read_only_files": [
    "**/.rustup/**",
    "**/.cargo/registry/**",
    "**/.cargo/git/**",
    "target/**/*.rs",
    "**/*.lock",
    "**/pnpm-lock.yaml",
    "**/.nuxt/**",
    "vendor/",
    ".config/mise/conf.d/tools*.toml",
    "src-tauri/gen/android/local.properties",
    "src-tauri/gen/android/gradle/lib.versions.toml",
    "src-tauri/gen/android/gradle/wrapper/gradle-wrapper.properties"
  ]
}
