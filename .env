# Quote every value: an unquoted space makes direnv reject the line and skip the rest of the file.
PROJECT_CONFIG_PATH="${PROJECT_ROOT}/.config"

JJ_HOOKS_RUNNER="hk"

CARGO_TARGET_DIR="${PROJECT_ROOT}/target"
CLIPPY_CONF_DIR="${PROJECT_CONFIG_PATH}"

TREEFMT_CONFIG="${PROJECT_CONFIG_PATH}/treefmt.toml"
TREEFMT_TREE_ROOT="${PROJECT_ROOT}"

RUBOCOP_OPTS="--config ${PROJECT_CONFIG_PATH}/rubocop.yml"

TAURI_APP_PATH="${PROJECT_ROOT}/src-tauri"
TAURI_FRONTEND_PATH="${PROJECT_ROOT}/src"
TAURI_ANDROID_PROJECT_PATH="${TAURI_APP_PATH}/gen/android"
TAURI_IOS_PROJECT_PATH="${TAURI_APP_PATH}/gen/apple"

TYPST_FEATURES="bundle,html"
TYPST_IGNORE_SYSTEM_FONTS="true"
TYPST_IGNORE_EMBEDDED_FONTS="true"
