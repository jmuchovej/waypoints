#!/usr/bin/env nu

# Refresh `.config/mise/mise.lock`, or with `--check` report whether it still
# agrees with the config fragments. Hand-invoked — see nix/AGENTS.md for why no
# devenv task writes the lockfile on shell entry.
#
# `mise lock` refreshes the platforms the lockfile already carries and will not
# add one. Widening takes `mise lock --platform <list>`.

# Every environment fragment on disk. `mise:prune-environments` has already
# removed any whose environment no longer has members, so what is there is
# what is current. All of them load at once: the lockfile covers the union.
def environments [root: string]: nothing -> list<string> {
  glob ($root | path join ".config" "mise" "conf.d" "tools.*.toml")
  | path parse
  | get stem
  | str replace --regex '^tools\.?' ""
  | sort
}

def main [
  --check # report drift instead of refreshing it; no network, writes nothing
] {
  let root = $env.PROJECT_ROOT? | default (pwd)
  let envs = (environments $root | str join ",")

  if $check {
    let result = (with-env {MISE_ENV: $envs} { do { mise lock --dry-run --json } | complete })
    mut problems = []

    # mise warns and still exits 0, so its output is the signal rather than
    # its exit code.
    let drift = ($result.stdout | str trim)
    if $drift != "[]" and ($drift | is-not-empty) {
      let names = ($drift | from json | get name | str join ", ")
      $problems = ($problems | append $"lockfile stale for ($names)")
    }

    # A backend spec mise cannot resolve surfaces here and nowhere else:
    # `mise ls --current` lists an unresolvable tool as merely missing.
    for warning in ($result.stderr | lines | where {|l| $l | str contains "WARN" }) {
      $problems = ($problems | append ($warning | str trim))
    }

    if ($problems | is-empty) { return }

    print -e "mise.lock disagrees with the config fragments:"
    for problem in $problems { print -e $"  ($problem)" }
    print -e ""
    print -e "Run `just mise-lock` to refresh it."
    exit 1
  }

  # GH_TOKEN arrives from secretspec via `just mise-lock`; mise reads
  # GITHUB_TOKEN. Unauthenticated, sixty requests an hour does not cover this
  # tool set and mise reports success after writing a short lockfile.
  let token = ($env.GITHUB_TOKEN? | default ($env.GH_TOKEN? | default ""))

  mise trust
  with-env { GITHUB_TOKEN: $token, MISE_ENV: $envs } {
    mise lock
  }
}
