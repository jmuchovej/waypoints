#!/usr/bin/env nu
# SPDX-FileCopyrightText: 2026 John Muchovej
# SPDX-License-Identifier: AGPL-3.0-or-later

# Renders the store assets, writes the listing copy fastlane reads, and runs
# the lanes.
#
#   xfastlane build    [locale]
#   xfastlane watch    [locale]
#   xfastlane metadata [flavor] [locale]
#   xfastlane clean
#   xfastlane prepare  [flavor] [locale]
#   xfastlane publish  <platform> [flavor] [--from <dir>]   (default: release)
#   xfastlane capture  <platform> [flavor] [locale] [--package <app|apk>] [--device <id>]
#
# A release runs `prepare` once, then `publish` per store. `prepare` does
# everything that touches nothing outside the machine — render, write, check,
# and on Linux fetch Transporter — so it fails before any submission has run.
# `publish` only runs the lane, from the app directory: fastlane finds its
# Fastfile by looking for `./fastlane` in the working directory, and supply and
# deliver resolve `metadata/` and `screenshots/` from the same place.

# Play truncates "What's new" at 500 characters; the App Store and TestFlight
# allow 4000. 500 is what the text has to survive.
const PLAY_NOTES_LIMIT = 500
const APPLE_NOTES_LIMIT = 4000

# Apple serves only its current Linux build, at this one unversioned URL.
const TRANSPORTER_URL = "https://itunesconnect.apple.com/WebObjects/iTunesConnect.woa/ra/resources/download/public/Transporter__Linux/bin"

def fastlane-root []: nothing -> path { $env.TAURI_APP_PATH | path join "fastlane" }

# Where `prepare` unpacks Transporter, and the flavor it last prepared.
def transporter-root []: nothing -> path { fastlane-root | path join ".transporter" }
def prepared-marker []: nothing -> path { fastlane-root | path join ".prepared" }

def flavor-config [flavor: string]: nothing -> path {
  $env.TAURI_APP_PATH | path join "res" "configs" "flavors" $"($flavor).toml"
}

# Cuts on a line boundary, so a bullet is never severed mid-word.
def fit [text: string, limit: int]: nothing -> string {
  if ($text | str length) <= $limit { return $text }
  mut kept = []
  for line in ($text | lines) {
    let candidate = ($kept | append $line | str join "\n")
    if ($candidate | str length) > ($limit - 1) { break }
    $kept = ($kept | append $line)
  }
  ($kept | str join "\n" | str trim) + "…"
}

# The frames and captures on disk, as root-relative paths, so the Typst can
# name a missing one instead of failing with its own file-not-found.
def present-inputs []: nothing -> list<string> {
  let root = $env.TAURI_APP_PATH
  let files = (
    [res captures]
      | each {|dir| glob (fastlane-root | path join $dir "**" "*.png") }
      | flatten
      | each {|p| "/" + ($p | path relative-to $root) }
  )
  ["--input" $"files=($files | to json --raw)"]
}

def "main build" [locale: string = "en-US"]: nothing -> nothing {
  cd (fastlane-root)

  # The trailing `.` is the bundle's output root: each `#document(..)` path is
  # a full path under it, so PNGs land straight in the directories supply and
  # deliver read. 72 ppi makes a `pt` in the source a pixel on disk; the
  # default 144 would double every dimension.
  with-env { TYPST_ROOT: $env.TAURI_APP_PATH } {
    ^typst compile --format bundle --ppi 72 ...(present-inputs) $"($locale).typ" .
  }

  # Both stores reject alpha on screenshots and the feature graphic, and both
  # require it on the icon.
  let pngs = (
    [metadata screenshots]
    | each {|dir| glob $"($dir)/**/*.png" }
    | flatten
    | where {|p| ($p | path basename) != "icon.png" }
  )
  for png in $pngs { ^magick $png -alpha off $"PNG24:($png)" }
  print $"rendered ($pngs | length) flattened assets for ($locale)"
}

def "main watch" [locale: string = "en-US"]: nothing -> nothing {
  cd (fastlane-root)
  # The presence list is taken once, so a capture minted mid-watch needs a restart.
  with-env { TYPST_ROOT: $env.TAURI_APP_PATH } {
    ^typst watch --format bundle --ppi 72 ...(present-inputs) $"($locale).typ" .
  }
}

def "main clean" []: nothing -> nothing {
  cd (fastlane-root)
  rm -rf metadata screenshots index.html .transporter .prepared
}

# FLAVOR only picks the listing name — preview and nightly ship under their own
# `productName`, which is why it is not in the copy file.
def "main metadata" [flavor: string = "stable", locale: string = "en-US"]: nothing -> nothing {
  cd (fastlane-root)

  let copy = (open $"($locale).toml")
  let name = (open (flavor-config $flavor) | get productName)
  let play = ($copy | get "google-play")
  let apple = ($copy | get "app-store")
  # TOML keeps the newline before the closing `'''`; the stores would show it.
  let description = ($copy.description | str trim)

  let android = $"metadata/android/($locale)"
  let ios = $"metadata/($locale)"

  let fields = [
    [path, value, limit];
    [$"($android)/title.txt", $name, 30]
    [$"($android)/short_description.txt", $play.short, 80]
    [$"($android)/full_description.txt", $description, 4000]
    [$"($ios)/name.txt", $name, 30]
    [$"($ios)/subtitle.txt", $apple.subtitle, 30]
    [$"($ios)/promotional_text.txt", $apple.promotional, 170]
    [$"($ios)/keywords.txt", ($apple.keywords | str join ","), 100]
    [$"($ios)/description.txt", $description, 4000]
  ]

  # A store rejects an over-long field on upload, by which point a release is
  # already in flight. Naming the field here is cheaper.
  let over = ($fields | where {|f| ($f.value | str length) > $f.limit })
  if ($over | is-not-empty) {
    for f in $over {
      print $"($f.path): ($f.value | str length) chars, limit ($f.limit)"
    }
    error make { msg: "listing copy exceeds a store limit" }
  }

  for f in $fields {
    mkdir ($f.path | path dirname)
    $f.value | save --force $f.path
  }
  print $"wrote ($fields | length) files for ($locale) as ($name)"

  # Per-release notes, internal testing included — a build whose notes say
  # nothing teaches its testers nothing. The plain-text template is used rather
  # than the markdown one the GitHub release gets: both stores strip markup.
  let cliff = (do {
    ^git-cliff --latest --strip all --body-file "changelog.tera"
  } | complete)
  let notes = (if $cliff.exit_code == 0 { $cliff.stdout | str trim } else { "" })

  if ($notes | is-empty) {
    # Never write an empty file: supply would upload blank notes, whereas
    # `default.txt`'s absence is what makes a store keep the previous ones.
    print "no changelog-worthy commits in the latest tag — release notes left alone"
    return
  }

  # supply reads `changelogs/<versionCode>.txt`, falling back to `default.txt`,
  # which spares us knowing the version code here.
  let play_notes = $"($android)/changelogs/default.txt"
  let ios_notes = $"($ios)/release_notes.txt"
  mkdir ($play_notes | path dirname)
  fit $notes $PLAY_NOTES_LIMIT | save --force $play_notes
  fit $notes $APPLE_NOTES_LIMIT | save --force $ios_notes
  print $"wrote release notes \(($notes | lines | length) lines\)"
}

# Fetched at run time, not projected: an exception under `toolchain/
# tool-projection`'s run-time-fetched-tool requirement. `--noexec` unpacks the
# Makeself archive without running Apple's install script (two licence prompts
# and a copy into /usr/local); Makeself still verifies its embedded checksum.
def fetch-transporter []: nothing -> nothing {
  let root = (transporter-root)
  let download = (mktemp -d)
  # `--remote-header-name` keeps Apple's filename, which names the build.
  let installer = (
    ^curl --fail --silent --show-error --location --proto "=https"
      --remote-name --remote-header-name --output-dir $download
      --write-out "%{filename_effective}" $TRANSPORTER_URL
  )
  rm -rf $root
  ^sh $installer --noexec --target $root
  rm -rf $download
  print $"unpacked ($installer | path basename) to ($root)"
}

def "main prepare" [flavor: string = "stable", locale: string = "en-US"]: nothing -> nothing {
  main build $locale
  main metadata $flavor $locale
  if $nu.os-info.name == "linux" { fetch-transporter }
  $flavor | save --force (prepared-marker)
}

# The one package under `dir` a lane submits: the aab for Play, the ipa for
# TestFlight.
def staged-package [platform: string, dir: path]: nothing -> path {
  let extension = (if $platform == "ios" { "ipa" } else { "aab" })
  let found = (glob $"($dir | path expand)/*.($extension)")
  if ($found | length) != 1 {
    error make { msg: $"expected one .($extension) in ($dir), found ($found | length); stage it with `cargo xtask release-stage --platform ($platform)`" }
  }
  $found | first
}

# Submits the package in `release-stage`'s flat directory, never the build
# output: staging is what checks the export and names the file. The iOS build
# stages AppStoreInfo.plist there too, beside the ipa, which is the one place
# fastlane reads it from.
def "main publish" [
  platform: string,
  flavor: string = "stable",
  --from: path = "release",  # the staged directory to take the package from
]: nothing -> nothing {
  # Never prepares on its own: that would move rendering and the Transporter
  # fetch back after the first submission whenever a caller skipped `prepare`.
  let marker = (prepared-marker)
  if not ($marker | path exists) or (open --raw $marker | str trim) != $flavor {
    error make { msg: $"run `xfastlane prepare ($flavor)` before `xfastlane publish`" }
  }

  let package = { WAYPOINTS_STORE_PACKAGE: (staged-package $platform $from) }

  # fastlane uploads to TestFlight through Transporter off macOS, and only
  # through its shell-script executor reads the AppStoreInfo.plist beside the ipa.
  let transporter = (
    if $platform == "ios" and $nu.os-info.name == "linux" {
      let itms = (transporter-root | path join "itms")
      if not ($itms | path exists) {
        error make { msg: $"no Transporter at ($itms); run `xfastlane prepare ($flavor)` on this machine" }
      }
      { FASTLANE_ITUNES_TRANSPORTER_USE_SHELL_SCRIPT: "true", FASTLANE_ITUNES_TRANSPORTER_PATH: $itms }
    } else { {} }
  )

  # On macOS fastlane finds Transporter inside Xcode, through DEVELOPER_DIR. The
  # devenv shell points that at a nix-store SDK with no xcodebuild, and fastlane
  # then fails on a nil Xcode version, so hand it the system's selected Xcode.
  let xcode = (
    if $platform == "ios" and $nu.os-info.name == "macos" and ($env.DEVELOPER_DIR? | default "" | str starts-with "/nix/store/") {
      { DEVELOPER_DIR: (^env -u DEVELOPER_DIR /usr/bin/xcode-select -p | str trim) }
    } else { {} }
  )

  # From the app directory, so `./fastlane` is the Fastfile's directory and the
  # metadata `prepare` wrote sits where supply and deliver look for it.
  cd $env.TAURI_APP_PATH
  with-env ($transporter | merge $xcode | merge $package) { ^fastlane $platform $flavor }
}

# ── capture ──────────────────────────────────────────────────────────────

# The devices the listing depicts; the frames in `res/` are theirs.
const CAPTURE_SIMULATOR = "iPhone 17 Pro"
const CAPTURE_AVD = "pixel_10_pro"

def captures-root [platform: string, locale: string]: nothing -> path {
  fastlane-root | path join "captures" $platform $locale
}

# The custom scheme FLAVOR registers on mobile (not the pairing host's entry).
def flavor-scheme [flavor: string]: nothing -> string {
  open (flavor-config $flavor)
    | get plugins."deep-link".mobile
    | where {|entry| "scheme" in ($entry | columns) }
    | first
    | get scheme
    | first
}

def xcode-dir []: nothing -> string { ^env -i PATH=/usr/bin:/bin xcode-select -p | str trim }

# Tauri refuses a simulator build unless an installed runtime's version, as a
# string, is at least the simulator SDK's. Checked first, in the same terms,
# so the fix is named here rather than after the frontend has built.
def check-simulator-runtime []: nothing -> nothing {
  let sdk = (with-env { DEVELOPER_DIR: (xcode-dir) } { ^xcrun --sdk iphonesimulator --show-sdk-version | str trim })
  let runtimes = (
    ^xcrun simctl list runtimes --json | from json | get runtimes
      | where {|r| $r.isAvailable and $r.platform == "iOS" }
      | get version
  )
  if not ($runtimes | any {|v| $v == $sdk or $v >= $sdk }) {
    error make { msg: $"no iOS ($sdk) simulator runtime, which Tauri requires to build for the simulator; install it with `xcodebuild -downloadPlatform iOS -buildVersion ($sdk)`" }
  }
}

def ios-simulator [device?: string]: nothing -> string {
  if $device != null { return $device }
  let found = (
    ^xcrun simctl list devices available --json | from json | get devices
      | transpose runtime devices
      | where runtime =~ "iOS"
      | sort-by runtime --reverse
      | each {|r| $r.devices | where name == $CAPTURE_SIMULATOR }
      | flatten
  )
  if ($found | is-empty) {
    error make { msg: $"no available ($CAPTURE_SIMULATOR) simulator; add one in Xcode › Window › Devices and Simulators" }
  }
  $found | first | get udid
}

# The deep-link plugin writes the flavor's scheme into the platform project from
# its build script, which a cached build skips (tauri-apps/plugins-workspace#3596).
def rerun-deep-link-build-script [...triples: string] {
  for triple in $triples {
    ^cargo clean -p tauri-plugin-deep-link --release --target $triple
  }
}

# Installs a fresh copy of the app and places the territory before its first
# launch. Returns the bundle identifier.
def ios-install [udid: string, flavor: string, territory: path, package?: path]: nothing -> string {
  let app = if $package != null { $package } else {
    check-simulator-runtime
    rerun-deep-link-build-script aarch64-apple-ios-sim
    ^xtauri build ios --flavor $flavor -- --target aarch64-sim --no-sign
    $env.TAURI_IOS_PROJECT_PATH | path join build arm64-sim Waypoints.app
  }
  let plist = ($app | path join Info.plist)
  let bundle = (^/usr/libexec/PlistBuddy -c "Print CFBundleIdentifier" $plist | str trim)
  # The deep-link plugin writes CFBundleURLTypes from its build script, which a
  # cached build skips; an app built that way can never be opened by its link.
  let scheme = (flavor-scheme $flavor)
  let types = (^/usr/libexec/PlistBuddy -c "Print CFBundleURLTypes" $plist | complete)
  if $types.exit_code != 0 or not ($types.stdout | lines | str trim | any {|l| $l == $scheme }) {
    error make { msg: $"($app) declares no ($scheme):// scheme; rebuild after `cargo clean -p tauri-plugin-deep-link --target aarch64-apple-ios-sim`" }
  }

  do -i { ^xcrun simctl boot $udid }
  ^xcrun simctl bootstatus $udid -b
  # Uninstalling drops the data container, so no earlier run's data survives.
  do -i { ^xcrun simctl uninstall $udid $bundle }
  ^xcrun simctl install $udid $app

  # Tauri's app_data_dir on iOS: Application Support, named by identifier.
  let container = (^xcrun simctl get_app_container $udid $bundle data | str trim)
  let data = ($container | path join Library "Application Support" $bundle)
  mkdir $data
  ls $territory | each {|entry| cp -r $entry.name $data }
  if not ($data | path join settings.json | path exists) {
    error make { msg: $"the demo territory is not where ($bundle) will look: ($data)" }
  }
  $bundle
}

def android-serial [device?: string]: nothing -> string {
  if $device != null { return $device }
  let running = { ^adb devices | lines | skip 1 | where $it =~ '^emulator-\S+\s+device' | each { split row -r '\s+' | first } }
  if (do $running | is-empty) {
    let avds = (^emulator -list-avds | lines)
    if $CAPTURE_AVD not-in $avds {
      error make { msg: $"no emulator running and no AVD named ($CAPTURE_AVD); create one on a Google APIs \(not Play\) image under `devenv shell -P emulator`" }
    }
    ^sh -c $"emulator -avd ($CAPTURE_AVD) -no-snapshot-save >/dev/null 2>&1 &"
    ^adb wait-for-device
    while (^adb shell getprop sys.boot_completed | str trim) != "1" { sleep 2sec }
  }
  do $running | first
}

# Installs a fresh copy of the apk and places the territory before its first
# launch. Returns the package name.
def android-install [serial: string, flavor: string, territory: path, package?: path]: nothing -> string {
  let apk = if $package != null { $package } else {
    # `xtauri build android` builds every Android triple the toolchain declares.
    let triples = open ($env.PROJECT_ROOT | path join rust-toolchain.toml) | get toolchain.targets | where $it =~ '-linux-android'
    rerun-deep-link-build-script ...$triples
    ^xtauri build android --flavor $flavor
    $env.TAURI_ANDROID_PROJECT_PATH | path join app build outputs apk universal release app-universal-release.apk
  }
  let aapt = (glob $"($env.ANDROID_HOME)/build-tools/*/aapt" | sort | last)
  let name = (^$aapt dump badging $apk | lines | first | parse "package: name='{name}'{rest}" | get name.0)

  do -i { ^adb -s $serial uninstall $name }
  ^adb -s $serial install $apk
  # A release apk is not debuggable, so only root can write into its data
  # directory, and only a Google APIs (non-Play) image grants it.
  let root = (^adb -s $serial root | complete)
  if $root.exit_code != 0 or ($root.stdout =~ "cannot run as root") {
    error make { msg: $"adb root refused on ($serial); capture needs a Google APIs \(not Play\) emulator image" }
  }
  ^adb -s $serial wait-for-device

  # Tauri's app_data_dir on Android is the app's own data directory.
  let data = $"/data/data/($name)"
  let owner = (^adb -s $serial shell stat -c "%u:%g" $data | str trim)
  ls $territory | each {|entry| ^adb -s $serial push $entry.name $data }
  ^adb -s $serial shell chown -R $owner $data
  # The pushed files must carry the data directory's own SELinux context, MLS
  # categories included, or the app cannot read them. `restorecon` leaves a
  # file whose type is already right but whose categories are not.
  let context = (^adb -s $serial shell ls -Zd $data | str trim | split row " " | first)
  ^adb -s $serial shell chcon -R $context $data
  if (^adb -s $serial shell ls $"($data)/settings.json" | complete | get exit_code) != 0 {
    error make { msg: $"the demo territory is not where ($name) will look: ($data)" }
  }
  $name
}

# Mints the app screenshots the listing composes. Run by hand; nothing in CI
# calls it.
#
# Boots the device, installs a fresh build of FLAVOR, places the demo
# territory (`cargo xtask demo-territory`) as a returning user's data before
# the app first launches, then runs every flow under `flows/` — one per
# screen, each opening its route link and waiting on text the screen renders —
# and keeps `captures/<platform>/<locale>/<screen>.png`. Composing them is
# `build`'s job; this invokes no Typst.
def "main capture" [
  platform: string,         # ios or android
  flavor: string = "stable",
  locale: string = "en-US", # keys the output only; the device's language is not changed
  --package: path,          # the build to install instead of building one: a simulator .app (ios) or an apk (android)
  --device: string,         # a simulator UDID or adb serial, instead of the default device
]: nothing -> nothing {
  if $platform not-in [ios android] {
    error make { msg: $"unknown platform ($platform); expected ios or android" }
  }

  let territory = (mktemp -d | path join "app-data")
  ^cargo xtask demo-territory $territory

  let device = if $platform == "ios" { ios-simulator $device } else { android-serial $device }
  let app_id = if $platform == "ios" {
    ios-install $device $flavor $territory $package
  } else {
    android-install $device $flavor $territory $package
  }

  let out = (captures-root $platform $locale)
  mkdir $out
  let scheme = (flavor-scheme $flavor)
  let flows = (glob (fastlane-root | path join flows "*.yaml"))

  # Each screen starts from a fresh launch that has reached the library, which
  # a placed territory lands on. Only then is the link opened: on iOS a link
  # that itself launches the app never reaches the frontend (2026-11-23), and
  # Maestro's own `openLink` raises a consent sheet that `simctl openurl` and
  # `am start` do not.
  let launch = (mktemp -d | path join "launch.yaml")
  $"appId: ($app_id)\n---\n- extendedWaitUntil:\n    visible: \"Library\"\n    timeout: 20000\n" | save $launch
  let maestro = {|flow: path, debug: path|
    with-env { MAESTRO_CLI_NO_ANALYTICS: "1" } {
      (^maestro --udid $device test -e $"APP_ID=($app_id)"
        --debug-output $debug --flatten-debug-output $flow)
    }
  }
  # When the library does not show, the app is usually there but hidden:
  # - iOS: the webview stays blank once activated until something repaints it,
  #   and a static library never does — a round trip through the other
  #   appearance forces one (the simulator's own is restored); a fresh
  #   install's first launch has also dropped behind the home screen.
  # - Android: a freshly booted emulator can raise "System UI isn't
  #   responding" over the app.
  let reach_library = {|debug: path|
    mut reached = (do $maestro $launch $debug | complete)
    for _ in 1..2 {
      if $reached.exit_code == 0 { break }
      if $platform == "ios" {
        let appearance = (^xcrun simctl ui $device appearance | str trim)
        ^xcrun simctl launch $device $app_id | complete
        ^xcrun simctl ui $device appearance (if $appearance == "dark" { "light" } else { "dark" })
        sleep 1sec
        ^xcrun simctl ui $device appearance $appearance
      } else {
        ^adb -s $device shell am broadcast -a android.intent.action.CLOSE_SYSTEM_DIALOGS | complete
        let activity = (
          ^adb -s $device shell cmd package resolve-activity --brief -c android.intent.category.LAUNCHER $app_id
            | lines | last | str trim
        )
        ^adb -s $device shell am start -n $activity | complete
        sleep 2sec
      }
      $reached = (do $maestro $launch $debug | complete)
    }
    if $reached.exit_code != 0 {
      print $reached.stdout
      error make { msg: $"($app_id) never reached the library; is the territory in place?" }
    }
  }

  for flow in $flows {
    let screen = ($flow | path parse | get stem)
    let link = $"($scheme)://(^yq 'select(document_index == 0) | .env.LINK' $flow | str trim)"
    let debug = (mktemp -d)
    if $platform == "ios" {
      do -i { ^xcrun simctl terminate $device $app_id } | complete
      ^xcrun simctl launch $device $app_id
    } else {
      ^adb -s $device shell am force-stop $app_id
      let activity = (
        ^adb -s $device shell cmd package resolve-activity --brief -c android.intent.category.LAUNCHER $app_id
          | lines | last | str trim
      )
      ^adb -s $device shell am start -W -n $activity
    }
    do $reach_library ($debug | path join launch)
    if $platform == "ios" {
      ^xcrun simctl openurl $device $link
    } else {
      ^adb -s $device shell am start -W -a android.intent.action.VIEW -d $"'($link)'" $app_id
    }
    do $maestro $flow $debug
    let shots = (glob $"($debug)/**/takeScreenshot/($screen).png")
    if ($shots | length) != 1 {
      error make { msg: $"($flow | path basename) wrote no `takeScreenshot: ($screen)`" }
    }
    cp ($shots | first) ($out | path join $"($screen).png")
    print $"captured ($screen) on ($platform)"
    rm -rf $debug
  }
  rm -rf ($territory | path dirname) ($launch | path dirname)
}

def main []: nothing -> nothing {
  help main
}
