#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 John Muchovej
# SPDX-License-Identifier: AGPL-3.0-or-later

set -euo pipefail

temp=$(mktemp)
trap 'rm -f "$temp"' EXIT

for file in "$@"; do
  if ! xmllint --format "$file" --output "$temp"; then
    echo "treefmt-xml: $file is not well-formed; left unchanged" >&2
    exit 1
  fi
  if ! cmp -s "$file" "$temp"; then
    cp "$temp" "$file"
  fi
done
