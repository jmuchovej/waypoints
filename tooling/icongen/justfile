# Icon generation for every app flavor
set script-interpreter := ["bash", "-euo", "pipefail"]

# Output placement comes from the same variables `tauri {ios,android} build`
# reads, so nothing here encodes the repo layout. devenv exports all three.
TAURI_ROOT := env("TAURI_APP_PATH")
ICONS_ROOT := TAURI_ROOT / "icons"
IOS_ROOT := env("TAURI_IOS_PROJECT_PATH")
ANDROID_ROOT := env("TAURI_ANDROID_PROJECT_PATH")

[private]
default: stable

# Generate icons for the dev flavor
dev: (generate "development")

# Generate icons for the nightly (nightly) flavor
nightly: (generate "nightly")

# Generate icons for the preview (preview) flavor
preview: (generate "preview")

# Generate icons for the stable (mainline) flavor
stable: (generate "stable")

# Generate icons for a given flavor
[script]
generate FLAVOR:
    [ -d node_modules ] || just icons::setup
    node icongen.ts --flavor {{ FLAVOR }}

# Install tooling dependencies
setup:
    pnpm install --filter @waypoints/icongen...

# Remove all generated icon artifacts
clean: clean-ios clean-android
    rm -rf {{ ICONS_ROOT }}/development {{ ICONS_ROOT }}/nightly {{ ICONS_ROOT }}/preview {{ ICONS_ROOT }}/stable

[private]
[working-directory(IOS_ROOT)]
clean-ios:
    rm -rf Assets.xcassets/AppIcon.appiconset

[private]
[working-directory(ANDROID_ROOT / "app/src/main/res")]
clean-android:
    fd "ic_launcher*" . -x rm {}
