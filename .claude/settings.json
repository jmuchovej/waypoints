{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just:*)",
      "Bash(just app:*)",
      "Bash(just tauri:*)",
      "Bash(bun add:*)",
      "Bash(bunx:*)",
      "Bash(cargo build:*)",
      "Bash(cargo info:*)",
      "Bash(cargo check:*)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:deepwiki.com)",
      "WebFetch(domain:tauri.app)",
      "WebFetch(domain:v2.tauri.app)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:lib.rs)",
      "WebFetch(domain:lucide.dev)",
      "WebFetch(domain:sea-ql.org)",
      "WebFetch(domain:specta.dev)",
      "WebFetch(domain:zed.dev)",
      "WebFetch(domain:localhost)",
      "WebSearch",
      "mcp__nuxt-ui",
      "mcp__filesystem",
      "mcp__github"
    ],
    "ask": ["mcp__filesystem__write_file", "Bash(bun run:*)", "Bash(git rm:*)"],
    "deny": ["Bash(npx:*)", "Bash(pnpx:*)"]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["nuxt-ui", "filesystem", "devenv"],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v hk >/dev/null 2>&1; then hk fix; else SECRETSPEC_REASON=\"Claude Code Stop hook runs hk fix to format and apply lint fixes to the working copy; no secret values are read\" devenv shell -- hk fix; fi || true",
            "statusMessage": "Formatting and applying lint fixes",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
